#include <SPI.h>
#include <MFRC522.h>
#include <SoftwareSerial.h>

// ======================
// WiFi Settings
// ======================
const char* ssid = "Airtel_Koushik";
const char* password = "1011110@Me";

// ======================
// Server Settings
// ======================
const char* serverIP = "192.168.1.11";
const int serverPort = 80;

// ======================
// RFID Pins
// ======================
#define SS_PIN 10
#define RST_PIN 9

MFRC522 mfrc522(SS_PIN, RST_PIN);

// ESP-01
SoftwareSerial esp8266(2, 3);

// Duplicate Protection
String lastUID = "";
unsigned long lastScanTime = 0;
const unsigned long scanCooldown = 5000;

// =====================================================

void setup()
{
  Serial.begin(9600);

  Serial.println();
  Serial.println("==================================");
  Serial.println("RFID Attendance System");
  Serial.println("==================================");

  SPI.begin();
  mfrc522.PCD_Init();

  Serial.println("[+] RC522 Ready");

  esp8266.begin(9600);

  Serial.println("[+] ESP01 Ready");

  connectWiFi();
}

// =====================================================

void loop()
{
  if (!mfrc522.PICC_IsNewCardPresent())
    return;

  if (!mfrc522.PICC_ReadCardSerial())
    return;

  String uid = "";

  for (byte i = 0; i < mfrc522.uid.size; i++)
  {
    if (mfrc522.uid.uidByte[i] < 0x10)
      uid += "0";

    uid += String(mfrc522.uid.uidByte[i], HEX);
  }

  uid.toUpperCase();

  if (uid == lastUID &&
      (millis() - lastScanTime < scanCooldown))
  {
    Serial.println("[!] Duplicate Scan Ignored");
    mfrc522.PICC_HaltA();
    return;
  }

  lastUID = uid;
  lastScanTime = millis();

  Serial.println();
  Serial.print("[+] RFID UID: ");
  Serial.println(uid);

  sendAttendance(uid);

  mfrc522.PICC_HaltA();
  mfrc522.PCD_StopCrypto1();
}

// =====================================================

void connectWiFi()
{
  Serial.println("[+] Connecting WiFi...");

  sendAT("AT", 2000);
  sendAT("AT+CWMODE=1", 2000);

  String cmd =
    "AT+CWJAP=\"" +
    String(ssid) +
    "\",\"" +
    String(password) +
    "\"";

  String response = sendAT(cmd, 20000);

  Serial.println(response);

  if (response.indexOf("WIFI GOT IP") != -1 ||
      response.indexOf("OK") != -1)
  {
    Serial.println("[+] WiFi Connected");
  }
  else
  {
    Serial.println("[!] WiFi Connection Failed");
  }
}

// =====================================================

void sendAttendance(String uid)
{
  Serial.println("[+] Connecting Server...");

  String cmd =
    "AT+CIPSTART=\"TCP\",\"" +
    String(serverIP) +
    "\"," +
    String(serverPort);

  String response = sendAT(cmd, 5000);

  Serial.println(response);

  if (response.indexOf("ERROR") != -1)
  {
    Serial.println("[!] TCP Connection Failed");
    return;
  }

  String postData =
    "rfid_uid=" + uid;

  String request =
    "POST /smart_school_src/scan.php HTTP/1.1\r\n"
    "Host: 192.168.1.11\r\n"
    "Content-Type: application/x-www-form-urlencoded\r\n"
    "Content-Length: " +
    String(postData.length()) +
    "\r\n"
    "Connection: close\r\n\r\n" +
    postData;

  cmd = "AT+CIPSEND=" + String(request.length());

  response = sendAT(cmd, 5000);

  if (response.indexOf(">") == -1)
  {
    Serial.println("[!] ESP Not Ready");
    Serial.println(response);

    sendAT("AT+CIPCLOSE", 1000);
    return;
  }

  esp8266.print(request);

  String serverResponse = "";

  unsigned long start = millis();

  while (millis() - start < 10000)
  {
    while (esp8266.available())
    {
      serverResponse += (char)esp8266.read();
    }
  }

  Serial.println();
  Serial.println("========== SERVER RESPONSE ==========");
  Serial.println(serverResponse);
  Serial.println("=====================================");

  sendAT("AT+CIPCLOSE", 1000);
}

// =====================================================

String sendAT(String cmd, int timeout)
{
  String response = "";

  while (esp8266.available())
    esp8266.read();

  esp8266.println(cmd);

  unsigned long start = millis();

  while (millis() - start < timeout)
  {
    while (esp8266.available())
    {
      response += (char)esp8266.read();
    }
  }

  return response;
}